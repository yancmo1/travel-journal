# Database
DATABASE_URL=postgresql://travel_user:travel_pass@postgres:5432/travel_tracker

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# Photo Storage
PHOTO_STORAGE_PATH=/app/media/travel-photos

# Home location for distance calculations
HOME_LATITUDE=35.4676
HOME_LONGITUDE=-97.5164

# Server
PORT=4000
NODE_ENV=development
