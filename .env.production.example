# Copy to .env.production on the Ubuntu host and chmod 600.

# GHCR image namespace. This repository publishes under yancmo1.
GHCR_OWNER=yancmo1
IMAGE_TAG=latest

# Host storage. Use an absolute path on a disk included in local monitoring.
DATA_ROOT=/srv/travel-journal/data
PHOTO_UID=1000
PHOTO_GID=1000
# The backend container runs as this uid/gid and must be able to read the
# backup status file written by the root-owned systemd job.
MAINTENANCE_UID=1000
MAINTENANCE_GID=1000
LOCAL_HTTP_PORT=3080
APP_HOSTNAME=postcardsofus.com
BACKUP_STALE_AFTER_HOURS=30
# Optional links shown on the site-admin Operations page. These URLs must be
# reachable from the browser that opens the page.
GRAFANA_URL=
PROMETHEUS_URL=

# Application secrets.
POSTGRES_DB=travel_tracker
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=replace_with_a_long_random_value
JWT_SECRET=replace_with_output_from_openssl_rand_base64_48
VITE_LEGACY_BEARER_AUTH=false
JWT_EXPIRES_IN=90d
# Keep false for the invite-only beta. Accounts are provisioned by the operator.
ALLOW_PUBLIC_REGISTRATION=false
HOME_LATITUDE=35.4676
HOME_LONGITUDE=-97.5164

# Restic repository in a private R2 bucket.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/travel-journal-backups
RESTIC_PASSWORD=replace_with_a_separate_long_random_value
AWS_ACCESS_KEY_ID=replace_with_r2_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
AWS_DEFAULT_REGION=auto

# Google Places request guardrails.
GOOGLE_PLACES_CACHE_TTL_MS=300000
GOOGLE_PLACES_CACHE_MAX_ENTRIES=200
LOCATION_CACHE_MAX_ENTRIES=5000

# Cloudflare beta feature flags and bounded-work limits.
ENABLE_BACKGROUND_JOBS=true
ENABLE_AUTOMATIC_BACKUPS=true
ENABLE_UPLOADS=true
ENABLE_INVITATIONS=true
ENABLE_SHARING=true
ENABLE_PLACES=true
ENABLE_LOCATION_LOOKUPS=true
ENABLE_HOUSEHOLD_DELETION=false
ENABLE_MIGRATION_ENDPOINTS=false
ENABLE_BACKUP_RUNNER=false
PHOTO_PROCESSOR_MODE=browser
VITE_USE_UPLOAD_SESSIONS=false
MAX_LOCATION_BACKFILL_PER_RUN=3
MAX_STORAGE_BYTES_PER_HOUSEHOLD=1073741824
MAX_UPLOAD_BYTES=20971520
MAX_UPLOADS_PER_REQUEST=5
MAX_UPLOADS_PER_DAY=0
MAX_UPLOAD_BYTES_PER_DAY=0
EXPORT_MEDIA_PER_JOB=10
