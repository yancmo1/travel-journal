{
  "name": "Postcards of Us",
  "short_name": "Postcards of Us",
  "description": "A private family storybook for keeping travel memories together.",
  "id": "/",
  "lang": "en-US",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "categories": ["lifestyle", "photo", "travel"],
  "prefer_related_applications": false,
  "background_color": "#f5f0e8",
  "theme_color": "#1e3730",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
