# Travel Memory Tracker - Environment Configuration
# Copy this file to .env and customize the values

# Database
POSTGRES_DB=travel_tracker
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=change_this_secure_password

# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_generate_me

# Local Docker development login. Leave blank outside local development.
# These values are used only when NODE_ENV=development.
NODE_ENV=development
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
DEV_USER_DISPLAY_NAME=

# Transactional email for invitations, verification, and password recovery.
# Production values are managed through Sites, not committed here.
RESEND_API_KEY=
EMAIL_FROM=Postcards of Us <postcards@mail.postcardsofus.com>
BUG_REPORT_TO=bugs@postcardsofus.com

# Home location for distance calculations (Oklahoma City, OK)
HOME_LATITUDE=35.4676
HOME_LONGITUDE=-97.5164

# Optional: Google Places Text Search (keep this server-side and out of source control)
GOOGLE_PLACES_API_KEY=
# Successful searches are cached server-side to reduce duplicate billable calls.
GOOGLE_PLACES_CACHE_TTL_MS=300000
GOOGLE_PLACES_CACHE_MAX_ENTRIES=200
LOCATION_CACHE_MAX_ENTRIES=5000

# Cloudflare beta safety controls. Keep background jobs enabled only when the
# scheduled runner is configured; all values are overrideable in hosted env.
ENABLE_BACKGROUND_JOBS=true
ENABLE_AUTOMATIC_BACKUPS=true
ENABLE_UPLOADS=true
ENABLE_INVITATIONS=true
ENABLE_SHARING=true
ENABLE_PLACES=true
ENABLE_LOCATION_LOOKUPS=true
ENABLE_HOUSEHOLD_DELETION=false
ENABLE_MIGRATION_ENDPOINTS=false
ENABLE_BACKUP_RUNNER=false
PHOTO_PROCESSOR_MODE=browser
VITE_USE_UPLOAD_SESSIONS=false
MAX_LOCATION_BACKFILL_PER_RUN=3
MAX_STORAGE_BYTES_PER_HOUSEHOLD=1073741824
MAX_UPLOAD_BYTES=20971520
MAX_UPLOADS_PER_REQUEST=5
MAX_UPLOADS_PER_DAY=0
MAX_UPLOAD_BYTES_PER_DAY=0
EXPORT_MEDIA_PER_JOB=10

# Application port
APP_PORT=8080

# Optional links shown on the site-admin Operations page.
GRAFANA_URL=
PROMETHEUS_URL=
