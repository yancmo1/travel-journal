# Travel Memory Tracker - Environment Configuration
# Copy this file to .env and customize the values

# Database
POSTGRES_DB=travel_tracker
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=change_this_secure_password

# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_generate_me

# Home location for distance calculations (Oklahoma City, OK)
HOME_LATITUDE=35.4676
HOME_LONGITUDE=-97.5164

# Optional: Google Places Text Search (keep this server-side and out of source control)
GOOGLE_PLACES_API_KEY=
# Successful searches are cached server-side to reduce duplicate billable calls.
GOOGLE_PLACES_CACHE_TTL_MS=300000
GOOGLE_PLACES_CACHE_MAX_ENTRIES=200

# Application port
APP_PORT=8080
